<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nuxeo</groupId>
    <artifactId>nuxeo-parent</artifactId>
    <version>2023.46</version>
  </parent>

  <groupId>org.nuxeo.compound.documents</groupId>
  <artifactId>nuxeo-compound-documents-parent</artifactId>
  <name>Nuxeo Compound Documents Parent</name>
  <version>2023.2.60</version>
  <packaging>pom</packaging>
  <description>Nuxeo Compound Documents allow binding several documents as parts of one complex document.</description>

  <properties>
    <frontend-plugin.node.version>v20.18.1</frontend-plugin.node.version>
    <frontend-plugin.node.download.root/>
    <frontend-plugin.node.server.id/>
    <frontend-plugin.node.npm.userconfig>${env.HOME}/.npmrc</frontend-plugin.node.npm.userconfig>
    <frontend-plugin.ftest.nuxeoUrl>http://localhost:8080</frontend-plugin.ftest.nuxeoUrl>
  </properties>

  <modules>
    <module>nuxeo-compound-documents</module>
    <module>nuxeo-compound-documents-package</module>
    <module>nuxeo-compound-documents-web</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.nuxeo.compound.documents</groupId>
        <artifactId>nuxeo-compound-documents</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.compound.documents</groupId>
        <artifactId>nuxeo-compound-documents-package</artifactId>
        <version>${project.version}</version>
        <type>zip</type>
      </dependency>
      <dependency>
        <groupId>org.nuxeo.compound.documents</groupId>
        <artifactId>nuxeo-compound-documents-web</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>maven-public-lts</id>
      <url>https://packages.nuxeo.com/repository/maven-public-lts</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <updatePolicy>always</updatePolicy>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>maven-public-lts</id>
      <url>https://packages.nuxeo.com/repository/maven-public-lts</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <!-- no need to enable snapshots for plugin repository -->
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>1.15.4</version>
          <configuration>
            <nodeVersion>${frontend-plugin.node.version}</nodeVersion>
            <nodeDownloadRoot>${frontend-plugin.node.download.root}</nodeDownloadRoot>
            <serverId>${frontend-plugin.node.server.id}</serverId>
            <environmentVariables>
              <NPM_CONFIG_USERCONFIG>${frontend-plugin.node.npm.userconfig}</NPM_CONFIG_USERCONFIG>
            </environmentVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <scm>
    <connection>scm:git:git://github.com/nuxeo/nuxeo-compound-documents.git</connection>
    <developerConnection>scm:git:ssh://git@github.com:nuxeo/nuxeo-compound-documents.git</developerConnection>
    <url>https://github.com/nuxeo/nuxeo-compound-documents</url>
  </scm>

</project>
