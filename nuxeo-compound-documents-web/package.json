{
  "name": "nuxeo-compound-documents-web",
  "version": "0.1.0",
  "description": "Nuxeo Compound Documents WebUI integration",
  "author": "Nuxeo",
  "license": "Apache-2.0",
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@nuxeo/nuxeo-web-ui-ftest": "~3.1.33",
    "@nuxeo/testing-helpers": "~3.1.33",
    "@open-wc/karma-esm": "^2.9.8",
    "@polymer/iron-icons": "^3.0.1",
    "@rollup/plugin-node-resolve": "^7.1.3",
    "@web/dev-server-legacy": "^0.1.6",
    "eslint": "^7.12.1",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-html": "^6.1.0",
    "eslint-plugin-import": "^2.22.1",
    "husky": "^4.3.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.1.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-firefox-launcher": "^2.1.2",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-sauce-launcher": "^4.3.6",
    "karma-sinon-chai": "^2.0.2",
    "karma-source-map-support": "^1.4.0",
    "karma-static": "^1.0.1",
    "lint-staged": "^10.5.1",
    "mocha": "^10.0.0",
    "prettier": "2.1.2",
    "rollup": "^2.80.0",
    "rollup-plugin-copy": "^3.3.0",
    "rollup-plugin-terser": "^7.0.2",
    "sinon": "^14.0.0",
    "sinon-chai": "^3.7.0"
  },
  "dependencies": {
    "@nuxeo/nuxeo-elements": "~3.1.33",
    "@nuxeo/nuxeo-ui-elements": "~3.1.33",
    "@polymer/iron-flex-layout": "^3.0.1",
    "@polymer/iron-icon": "^3.0.1",
    "@polymer/paper-spinner": "^3.0.2",
    "@polymer/polymer": "^3.4.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "tar": "7.5.13",
    "moment": "2.30.1",
    "serialize-javascript": "7.0.5",
    "semver-regex": "3.1.4",
    "@koa/cors": "5.0.0",
    "babel-register": "npm:@babel/register@7.28.6",
    "babel-core": "npm:@babel/core@7.29.0",
    "babel-preset-env": "npm:@babel/preset-env@7.29.2",
    "cross-spawn": "6.0.6",
    "diff": "8.0.3",
    "got": "11.8.6",
    "puppeteer-core": {
      "ws": "8.20.0",
      "tar-fs": "2.1.4"
    },
    "yargs-parser": "5.0.1",
    "tmp": "0.2.4",
    "browserslist-useragent": "4.0.0",
    "request": "npm:@cypress/request@3.0.10"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint . --ext .js,.html",
    "lint:prettier": "prettier \"**/*.{js,html}\" --check || (echo '↑↑ these files are not prettier formatted ↑↑' && exit 1)",
    "format": "npm run format:prettier && npm run format:eslint",
    "format:eslint": "eslint --ext .js,.html . --fix",
    "format:prettier": "prettier \"**/*.{js,html}\" --write",
    "test": "karma start --coverage",
    "test:watch": "karma start --auto-watch=true --single-run=false",
    "ftest": "cd ftest && nuxeo-web-ui-ftest --screenshots --report --headless",
    "ftest:watch": "cd ftest && nuxeo-web-ui-ftest --debug --tags=@watch"
  }
}
